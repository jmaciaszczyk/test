---
import Icon from "./Icon.astro";
import site from "../data/business.json";

const business = site.business;
const address = business.address;
---

<section id="contact" class="border-t border-border bg-muted py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground">Find us</h2>

    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      {address.oneLine && (
        <div>
          <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-muted-foreground">
            <Icon name="pin" class="size-4" />
            Address
          </h3>
          <address class="mt-3 not-italic leading-relaxed text-foreground">
            {address.street && <span class="block">{address.street}</span>}
            <span class="block">
              {[address.postalCode, address.city].filter(Boolean).join(" ")}
            </span>
            {address.region && <span class="block">{address.region}</span>}
            {address.country && <span class="block">{address.country}</span>}
          </address>
          {business.mapUrl && (
            <a
              href={business.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex min-h-11 items-center rounded-lg text-sm font-semibold text-brand-700 underline underline-offset-4 hover:text-brand-800"
            >
              Get directions
            </a>
          )}
        </div>
      )}

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
          Get in touch
        </h3>
        <ul class="mt-3 space-y-1">
          {business.phoneHref && (
            <li>
              <a
                class="inline-flex min-h-11 items-center gap-2.5 rounded-lg text-foreground transition-colors hover:text-brand-700"
                href={business.phoneHref}
              >
                <Icon name="phone" class="size-4 text-brand-600" />
                {business.phone}
              </a>
            </li>
          )}
          {business.email && (
            <li>
              <a
                class="inline-flex min-h-11 items-center gap-2.5 rounded-lg break-all text-foreground transition-colors hover:text-brand-700"
                href={`mailto:${business.email}`}
              >
                <Icon name="mail" class="size-4 text-brand-600" />
                {business.email}
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    {address.mapEmbedUrl && (
      <div class="mt-10 overflow-hidden rounded-2xl border border-border">
        <iframe
          src={address.mapEmbedUrl}
          title={`Map showing the location of ${business.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-80 w-full border-0"
        ></iframe>
      </div>
    )}
  </div>
</section>
