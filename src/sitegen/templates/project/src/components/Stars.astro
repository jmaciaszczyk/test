---
import Icon from "./Icon.astro";

const { rating, class: className = "" } = Astro.props;
const filled = Math.round(rating);
---

<span class={`inline-flex items-center gap-0.5 ${className}`} role="img"
      aria-label={`Rated ${rating} out of 5`}>
  {[1, 2, 3, 4, 5].map((step) => (
    <Icon
      name="star"
      filled={step <= filled}
      class={step <= filled ? "size-4 text-accent-500" : "size-4 text-border"}
    />
  ))}
</span>
