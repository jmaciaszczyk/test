---
import Icon from "./Icon.astro";
import site from "../data/business.json";

const links = [];
if (site.reviews.items.length > 0) links.push({ href: "#reviews", label: "Reviews" });
if (site.services.length > 0) links.push({ href: "#services", label: "Services" });
if (site.about.paragraphs.length > 0) links.push({ href: "#about", label: "About" });
if (site.hours.length > 0) links.push({ href: "#hours", label: "Hours" });
links.push({ href: "#contact", label: "Contact" });
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2">
    <a
      href="/"
      class="inline-flex min-h-11 items-center rounded-lg text-lg font-extrabold tracking-tight text-foreground"
    >
      {site.business.name}
    </a>

    <nav aria-label="Sections" class="hidden items-center gap-1 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-brand-700"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      {site.cta.url && (
        <a
          href={site.cta.url}
          class="inline-flex min-h-11 items-center rounded-full bg-brand-600 px-5 text-sm font-semibold text-on-brand transition-colors hover:bg-brand-700"
        >
          {site.cta.label}
        </a>
      )}

      <details class="relative md:hidden">
        <summary
          class="inline-flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg text-foreground transition-colors hover:bg-muted [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <Icon name="menu" class="size-6" />
        </summary>
        <nav
          aria-label="Sections"
          class="absolute right-0 top-full z-50 mt-2 w-52 rounded-xl border border-border bg-card p-2 shadow-lg"
        >
          {links.map((link) => (
            <a
              href={link.href}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-brand-700"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
