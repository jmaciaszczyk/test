---
import Icon from "./Icon.astro";
import site from "../data/business.json";
---

<section id="hours" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="flex items-center gap-2.5 text-3xl font-bold tracking-tight text-foreground">
      <Icon name="clock" class="size-7 text-brand-600" />
      Opening hours
    </h2>

    <dl class="mt-8 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">
      {site.hours.map((entry) => (
        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <dt class="font-medium text-foreground">{entry.day}</dt>
          <dd
            class={
              entry.closed
                ? "text-sm text-muted-foreground"
                : "font-medium tabular-nums text-foreground"
            }
          >
            {entry.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
