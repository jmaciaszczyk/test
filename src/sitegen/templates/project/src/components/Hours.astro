---
import site from "../data/business.json";
---

<section id="hours" class="border-t border-slate-200 py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Opening hours</h2>

    <dl class="mt-8 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200">
      {site.hours.map((entry) => (
        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <dt class="font-medium text-slate-900">{entry.day}</dt>
          <dd class={entry.closed ? "text-slate-400" : "text-slate-600"}>
            {entry.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
