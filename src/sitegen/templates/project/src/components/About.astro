---
import site from "../data/business.json";
---

<section id="about" class="border-t border-border bg-muted py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground">
      {site.about.heading}
    </h2>

    <div class="mt-6 space-y-4">
      {site.about.paragraphs.map((paragraph) => (
        <p class="text-lg leading-relaxed text-pretty text-muted-foreground">
          {paragraph}
        </p>
      ))}
    </div>
  </div>
</section>
