---
import site from "../data/business.json";
---

<section id="services" class="border-t border-border py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4">
    <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground">
      What we do
    </h2>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {site.services.map((service) => (
        <li class="rounded-2xl border border-border bg-card p-6 transition-colors hover:border-brand-300">
          <h3 class="text-lg font-semibold text-foreground">{service.name}</h3>
          {service.description && (
            <p class="mt-2 text-sm leading-relaxed text-pretty text-muted-foreground">
              {service.description}
            </p>
          )}
          {service.price && (
            <p class="mt-4 text-sm font-semibold text-brand-700">{service.price}</p>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
