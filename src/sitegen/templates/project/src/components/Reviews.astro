---
import Icon from "./Icon.astro";
import Stars from "./Stars.astro";
import site from "../data/business.json";

const reviews = site.reviews;
---

<section id="reviews" class="border-t border-border bg-muted py-16 sm:py-20">
  <div class="mx-auto max-w-5xl px-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground">
        What people say
      </h2>
      {reviews.rating !== null && (
        <p class="flex items-center gap-2 text-sm text-muted-foreground">
          <Stars rating={reviews.rating} />
          <span class="font-semibold text-foreground">{reviews.rating} out of 5</span>
        </p>
      )}
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.items.map((review) => (
        <li class="flex flex-col rounded-2xl border border-border bg-card p-6">
          <Icon name="quote" filled={true} class="size-6 text-brand-200" />
          <blockquote class="mt-4 grow text-pretty leading-relaxed text-foreground">
            {review.quote}
          </blockquote>
          <div class="mt-5 flex items-center justify-between gap-3">
            {review.author && (
              <cite class="text-sm font-semibold not-italic text-muted-foreground">
                {review.author}
              </cite>
            )}
            {review.rating !== null && <Stars rating={review.rating} />}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
