---
import site from "../data/business.json";

const business = site.business;
---

<section class="bg-linear-to-b from-brand-50 to-white">
  <div class="mx-auto max-w-5xl px-4 py-20 sm:py-28">
    {business.address.city && (
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-700">
        {business.address.city}
      </p>
    )}

    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
      {business.name}
    </h1>

    {business.tagline && (
      <p class="mt-4 text-xl text-slate-600">{business.tagline}</p>
    )}

    {business.description && (
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
        {business.description}
      </p>
    )}

    <div class="mt-10 flex flex-wrap items-center gap-3">
      {site.cta.url && (
        <a
          href={site.cta.url}
          class="rounded-full bg-brand-600 px-6 py-3 text-base font-semibold text-on-brand transition hover:bg-brand-700"
        >
          {site.cta.label}
        </a>
      )}
      {business.phoneHref && (
        <a
          href={business.phoneHref}
          class="rounded-full border border-slate-300 px-6 py-3 text-base font-semibold text-slate-700 transition hover:border-brand-400 hover:text-brand-700"
        >
          {business.phone}
        </a>
      )}
    </div>
  </div>
</section>
