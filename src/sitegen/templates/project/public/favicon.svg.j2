<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" role="img" aria-label="{{ business.name | e }}">
  <rect width="64" height="64" rx="14" fill="{{ brand.primary }}" />
  <text x="32" y="44" text-anchor="middle" fill="{{ brand.onPrimary }}"
        font-family="system-ui, sans-serif" font-size="34" font-weight="700">{{ (business.name or '?')[0] | upper | e }}</text>
</svg>
